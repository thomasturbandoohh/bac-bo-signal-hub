# Copy to .env (never commit .env). Fill in values from your own backend/hosting.
# Only VITE_* variables reach the browser; they must hold PUBLIC configuration only.

# Public backend configuration (browser + server)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Same public configuration, read by server code (SSR / server functions)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# SERVER-ONLY secrets: never prefix with VITE_, never import in browser code.
# Needed to delete accounts and to sync the live table feed.
SUPABASE_SERVICE_ROLE_KEY=
# Optional fallback name for the same server key.
DB_SERVICE_ROLE_KEY=
# Optional fallback live table key (normally saved by the admin in the panel).
LYNXMETRICS_API_KEY=
